# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Package convention: do not commit the lockfile for a library (consumers
# resolve their own). Anchored to the repo root so it doesn't also match
# example/pubspec.lock (the example/ app below is the opposite convention —
# app lockfiles ARE committed).
/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Exclude generated plugin registrant
lib/generated_plugin_registrant.dart

# --- example/ app (opposite pubspec.lock convention: app locks are committed) ---
example/build/
example/.dart_tool/
example/.flutter-plugins
example/.flutter-plugins-dependencies
example/linux/flutter/ephemeral/
example/linux/flutter/generated_plugin_registrant.*
example/linux/flutter/generated_plugins.cmake
